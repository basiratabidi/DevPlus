# The DevPulse backend URL to report errors to (ask the DevPulse owner).
DEVPULSE_BACKEND_URL=http://localhost:3000

# The shared secret DevPulse's /logs/ingest-error expects
# (must match LOG_INGEST_SECRET in the DevPulse backend's .env).
DEVPULSE_LOG_INGEST_SECRET=change-me

# What this project's errors show up as in DevPulse (the "[project]" prefix).
DEVPULSE_PROJECT_NAME=demo-external-project

PORT=4100
