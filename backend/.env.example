DATABASE_URL=postgresql://user:password@localhost:5432/devpulse

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE_NAME=devpulse

CRON_SECRET=change_me_to_a_random_string

PORT=3000

# Jira integration (optional - incidents/blockers still work without
# this, Jira issue creation is a best-effort side effect only)
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=PROJ
JIRA_INCIDENT_ISSUE_TYPE=Bug
JIRA_BLOCKER_ISSUE_TYPE=Task